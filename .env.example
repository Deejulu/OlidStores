# Example environment variables (do NOT commit real secrets)
# Copy to `.env` locally and fill with real values. Do NOT commit `.env`.

# Django
DJANGO_SECRET_KEY=replace-with-your-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (example for Postgres)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Supabase (S3-compatible storage)
SUPABASE_URL=https://ctfpsxzioblsikutqmnm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=your-bucket-name

# Optional AWS/S3-compatible fallbacks
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=

# Email providers
# SENDGRID_API_KEY=
# BREVO_API_KEY=
# Rename this file to .env and fill in your local values.
# Keep .env out of version control; do not share secrets.

EMAIL_BACKEND=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_SENDER_EMAIL=your-verified-sendgrid-email@example.com
SENDGRID_SENDER_NAME=E-Stores
DEFAULT_FROM_EMAIL=your-verified-sendgrid-email@example.com
OTP_DEBUG_MODE=True
