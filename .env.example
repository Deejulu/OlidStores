EMAIL_BACKEND=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_SENDER_EMAIL=your-verified-sendgrid-email@example.com
SENDGRID_SENDER_NAME=E-Stores
DEFAULT_FROM_EMAIL=your-verified-sendgrid-email@example.com
OTP_DEBUG_MODE=True
